<resources>
    <string name="title_activity_settings" translatable="false">@string/action_settings</string>

    <!-- Section heading for general settings -->
    <string name="pref_header_general">General</string>
    <!-- Keep a record of the last page (frame) that was opened when the user closes the app -->
    <string name="pref_title_remember_position">Remember my place</string>
    <!-- description of remember last page settings entry -->
    <string name="pref_description_remember_position">Display the last viewed page when starting the app</string>

    <!-- flag to always share when app is open -->
    <string name="pref_title_always_share">Always Share</string>
    <!-- description of always share entry -->
    <string name="pref_description_always_share">Allow nearby translators to import my translations while the app is open</string>

    <string name="pref_title_color_theme">Color Theme</string>
    <string-array name="pref_color_theme_titles">
        <item>Light</item>
        <item>Dark</item>
        <item>System</item>
    </string-array>

    <!-- Title for the typefaced used in the app -->
    <string name="pref_title_translation_typeface">Translation Font</string>
    <string-array name="pref_translation_typeface_titles" translatable="false">
        <item>Gentium Plus</item>
    </string-array>
    <!-- The font size of the translation typeface -->
    <string name="pref_title_typeface_size">Translation Font Size</string>
    <string-array name="pref_typeface_size_titles">
        <item>small</item>
        <item>normal</item>
        <item>medium</item>
        <item>large</item>
    </string-array>

    <string name="pref_title_source_typeface">Source Font</string>
    <string name="pref_title_source_typeface_size">Source Font Size</string>

    <!-- Section heading for the Upload settings -->
    <string name="pref_header_synchronization">Server</string>
    <!-- Changes in the translation will be saved automatically -->
    <!--<string name="pref_title_autosave_delay">Auto Save Changes</string>-->
    <!-- The server used to authenticate the device -->
    <string name="pref_title_auth_server">Authentication Server</string>
    <!-- The port on the server used to authenticate the device -->
    <string name="pref_title_auth_server_port">Authentication Server Port</string>
    <!-- The server to which data is uploaded -->
    <string name="pref_title_git_server">Git Server</string>
    <!-- The port on the server to which data is uploaded -->
    <string name="pref_title_git_server_port">Git Server Port</string>
    <!-- The server used to perform api requests with the git server-->
    <string name="pref_title_data_server">Data Server</string>
    <!-- The server used to perform api requests with the git server-->
    <string name="pref_title_gogs_api">Git Server API</string>
    <!-- The server from which data is downloaded -->
    <string name="pref_title_media_server">Media Server</string>
    <!-- The server used to review translation work in reader -->
    <string name="pref_title_reader_server">Reader Server</string>
    <!-- The URL to download the list of languages -->
    <string name="pref_title_language_url">Language URL</string>
    <string name="pref_title_index_sqlite_url">Index.sqlite URL</string>
    <string name="pref_title_tm_url">Translation Manual URL</string>
    <!-- The URL to create a new account. -->
    <string name="pref_title_create_account_url">Account Creation URL</string>

    <!-- Section heading for Advanced settings -->
    <string name="pref_header_advanced">Advanced</string>
    <!-- Tools within the app to assist developers -->
    <string name="pref_title_migrate_old_app">Migrate from old app</string>
    <string name="pref_description_migrate_old_app">Migrate translations from the old app data folder</string>
    <!-- Tools within the app to assist developers -->
    <string name="pref_title_developer_tools">Developer Tools</string>
    <!-- The minimum severity of logged messages within the app -->
    <string name="pref_title_logging_level">Logging Level</string>
    <!-- The severity or type of messages logged in the app -->
    <string-array name="pref_logging_level_titles">
        <item>Information</item>
        <item>Warnings</item>
        <item>Errors</item>
    </string-array>
    <!-- The length of time between automatic translation backups -->
    <string-array name="pref_backup_interval_titles">
        <item>1 Minute</item>
        <item>5 Minutes</item>
        <item>10 Minutes</item>
        <item>Disable Backup</item>
    </string-array>

    <!-- Section heading for Legal settings -->
    <string name="pref_header_legal">Legal</string>

    <string name="pref_title_software_licenses">Software Licenses</string>
